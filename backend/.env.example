# ==============================================================================
# DARK LIVE CHAT BACKEND CONFIGURATION
# ==============================================================================

# Server Port & Host
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Allowed Origins for CORS & Socket.IO (comma-separated or single)
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,https://dark-dev.vercel.app

# Database Path (SQLite)
DB_PATH=./src/database/livechat.sqlite

# Discord Bot Credentials
# Obtain your Bot Token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Discord Channel ID where live chat tickets / messages will be sent
DISCORD_CHANNEL_ID=YOUR_DISCORD_SUPPORT_CHANNEL_ID_HERE

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_MESSAGES=5
